# Smart Emergency Resource Allocation System — environment template.
# Copy to .env (git-ignored) and fill in. This file holds PLACEHOLDERS ONLY: never commit real
# secrets, and never paste real credentials into issues, logs or chat.

# ─── Server ───
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── JWT auth (REQUIRED when NODE_ENV=production; use a long random value) ───
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=8h

# ─── Storage mode (explicit; MUST be set when NODE_ENV=production) ───
#   true  = in-memory DEMO store: data is NOT persisted and is lost on every restart;
#           works for one process only. Never use it for real operations.
#   false = MySQL: persistent, shared, transactional. Requires the DB_* settings below.
# If MySQL mode cannot connect, or the schema is out of date, the server REFUSES TO START.
# It never falls back to the in-memory store.
DB_USE_MEMORY=true

# ─── MySQL (read only when DB_USE_MEMORY=false; there are no defaults) ───
# Create a dedicated, least-privilege user for the application (not root) and give it a password.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=emergency_system
DB_USER=eris_app
DB_PASS=replace-with-a-strong-password
DB_POOL_SIZE=20

# ─── Test database (put these in .env.local, NOT here; used only by `npm run test:mysql`) ───
# MYSQL_TEST_HOST=127.0.0.1
# MYSQL_TEST_PORT=3306
# MYSQL_TEST_USER=eris_test
# MYSQL_TEST_PASS=replace-with-a-strong-password
# MYSQL_TEST_DB=emergency_system_test   # the name MUST end in _test: the tests drop and recreate its tables
